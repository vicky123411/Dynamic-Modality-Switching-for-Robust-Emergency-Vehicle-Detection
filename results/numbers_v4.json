 "FIG1": "\\begin{figure}[t]\n\\centering\n\\resizebox{\\textwidth}{!}{%\n\\begin{tikzpicture}[\n  font=\\small,\n  >={Triangle[length=2mm,width=1.8mm]},\n  box/.style={draw=slate,line width=0.8pt,rounded corners=3pt,align=center,\n    inner sep=3pt,minimum height=9mm,text width=26mm},\n  io/.style  ={box,fill=gray!15},\n  net/.style ={box,fill=cyan!22!blue!8,text width=29mm},\n  cal/.style ={box,fill=teal!28!white},\n  feat/.style={box,fill=blue!14!white,text width=30mm},\n  gt/.style  ={box,fill=blue!28!teal!18!white,text width=28mm},\n  pl/.style  ={box,fill=blue!45!black!18!white,text width=34mm},\n  dc/.style  ={box,fill=slate,text=white,text width=24mm},\n  lab/.style ={font=\\footnotesize,inner sep=1.5pt}\n]\n\\colorlet{slate}{blue!55!black}\n\\node[io]   (xv)  at (0, 1.5)  {Video frame $x_v$};\n\\node[net]  (fv)  at (3.4, 1.5) {Vision branch\\\\MobileNetV3-Small};\n\\node[cal]  (cv)  at (6.8, 1.5) {Calibration $T_v$};\n\\node[io]   (xa)  at (0,-1.5)  {Audio window $x_a$};\n\\node[net]  (fa)  at (3.4,-1.5) {Audio branch\\\\log-Mel CNN};\n\\node[cal]  (ca)  at (6.8,-1.5) {Calibration $T_a$};\n\\node[feat] (phi) at (6.8, 0)   {Context descriptor\\\\$\\phi(x)\\in\\mathbb{R}^{17}$};\n\\node[gt]   (g)   at (10.4, 0)  {Reliability gate\\\\$w_v,\\ w_a=1-w_v$};\n\\node[pl]   (po)  at (14.4, 0)  {Log-odds pooling\\\\$\\sigma(w_v\\operatorname{logit}\\hat p_v+w_a\\operatorname{logit}\\hat p_a+b)$};\n\\node[dc]   (de)  at (18.2, 0)  {EV present\\\\if $s(x)\\ge\\tau$};\n\\draw[->,slate] (xv) -- (fv);\n\\draw[->,slate] (fv) -- node[lab,above]{$p_v$} (cv);\n\\draw[->,slate] (xa) -- (fa);\n\\draw[->,slate] (fa) -- node[lab,above]{$p_a$} (ca);\n\\draw[->,slate] (xv.south) |- (phi.west);\n\\draw[->,slate] (xa.north) |- (phi.west);\n\\draw[->,slate!55,dashed] (cv.south) -- (phi.north);\n\\draw[->,slate!55,dashed] (ca.north) -- (phi.south);\n\\draw[->,slate,line width=1pt] (phi) -- (g);\n\\draw[->,slate,line width=1pt] (g) -- (po);\n\\draw[->,slate] (cv.east) -| node[lab,above,pos=0.25]{$\\hat p_v$} (po.north);\n\\draw[->,slate] (ca.east) -| node[lab,below,pos=0.25]{$\\hat p_a$} (po.south);\n\\draw[->,slate,line width=1pt] (po) -- (de);\n\\end{tikzpicture}}\n\\caption{Pipeline: temperature-scaled confidences are pooled in log-odds space\nwith a per-sample weight from the reliability gate.}\n\\label{fig:architecture}\n\\end{figure}\n",
